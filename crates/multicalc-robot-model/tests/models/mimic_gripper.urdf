<?xml version="1.0"?>
<!-- Two prismatic fingers; the second mimics the first with multiplier -1 and offset 0.01. -->
<robot name="mimic_gripper">
  <link name="palm">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <joint name="finger_joint1" type="prismatic">
    <parent link="palm"/><child link="finger1"/>
    <origin xyz="0 0.05 0"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04"/>
  </joint>
  <link name="finger1">
    <inertial><mass value="0.1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <joint name="finger_joint2" type="prismatic">
    <parent link="palm"/><child link="finger2"/>
    <origin xyz="0 -0.05 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0"/>
    <mimic joint="finger_joint1" multiplier="-1" offset="0.01"/>
  </joint>
  <link name="finger2">
    <inertial><mass value="0.1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
