<?xml version="1.0"?>
<!-- A link stating a mass of zero. A link carrying no mass at all leaves the block out; stating
     zero states something a body cannot have. -->
<robot name="bad_zero_mass">
  <link name="base_link">
    <inertial>
      <mass value="0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>
</robot>
