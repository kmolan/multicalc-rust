<?xml version="1.0"?>
<!-- The world-link floating-base anchor pattern. Fixed versus floating base is a load-time
     choice by the caller, so this is rejected. -->
<robot name="bad_floating_joint">
  <link name="world"/>
  <joint name="floats" type="floating">
    <parent link="world"/><child link="base_link"/>
  </joint>
  <link name="base_link">
    <inertial><mass value="5"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1"/>
  </joint>
  <link name="upper_arm">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
