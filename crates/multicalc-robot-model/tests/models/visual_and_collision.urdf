<?xml version="1.0"?>
<!-- <visual> and <collision> with package:// meshes. Both are skipped as link children, so
     neither is listed in ignored() and no mesh is resolved. -->
<robot name="visual_and_collision">
  <link name="base_link">
    <inertial><mass value="2"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><mesh filename="package://nowhere/meshes/base.stl"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.2"/></geometry>
    </collision>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1"/>
  </joint>

  <link name="upper_arm">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual>
      <geometry><mesh filename="package://nowhere/meshes/upper_arm.dae"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.4"/></geometry>
    </collision>
  </link>
</robot>
