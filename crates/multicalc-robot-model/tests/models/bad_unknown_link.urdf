<?xml version="1.0"?>
<!-- A joint naming a link the file never declares. -->
<robot name="bad_unknown_link">
  <link name="base_link">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <joint name="shoulder" type="fixed">
    <parent link="base_link"/><child link="missing_link"/>
  </joint>
</robot>
