<?xml version="1.0"?>
<!-- <safety_controller> soft limits inside the hard <limit>. The hard pair is what is read. -->
<robot name="safety_controller">
  <link name="base_link">
    <inertial><mass value="2"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="100" velocity="2"/>
    <safety_controller soft_lower_limit="-2" soft_upper_limit="2" k_position="15" k_velocity="10"/>
  </joint>

  <link name="upper_arm">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
