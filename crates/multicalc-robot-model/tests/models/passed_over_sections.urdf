<?xml version="1.0"?>
<!-- A working arm alongside the top-level sections this reader takes nothing from, to check they
     are named rather than going quietly. -->
<robot name="passed_over_sections">
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <link name="base_link">
    <inertial><mass value="2"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1"/>
  </joint>

  <link name="upper_arm">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <transmission name="shoulder_drive">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="shoulder"/>
    <actuator name="shoulder_motor"/>
  </transmission>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
</robot>
