<?xml version="1.0"?>
<!-- A joint free to slide about in a plane, which this reader does not handle. -->
<robot name="bad_planar_joint">
  <link name="base_link">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <joint name="slider" type="planar">
    <parent link="base_link"/><child link="plate"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 0 1"/>
  </joint>
  <link name="plate">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
</robot>
