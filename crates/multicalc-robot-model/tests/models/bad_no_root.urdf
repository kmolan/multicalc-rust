<?xml version="1.0"?>
<!-- Each link hangs off the other, so neither one is at the top and the model has no root. -->
<robot name="bad_no_root">
  <link name="first">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <link name="second">
    <inertial><mass value="1"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <joint name="down" type="fixed">
    <parent link="first"/><child link="second"/>
  </joint>
  <joint name="back_up" type="fixed">
    <parent link="second"/><child link="first"/>
  </joint>
</robot>
